{
  "name": "kamus-terbuka",
  "version": "1.1.0",
  "description": "Fast, offline Indonesian lexicon & slang library for Node.js using an indexed SQLite engine.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "convert-db": "node helpers/converter/convert-db.js",
    "build-db-ai": "node helpers/enricher/build-db-ai.js",

    "enricher": "node helpers/enricher/enricher.js",
    "enricher:manager": "node helpers/enricher/enricher-manager.js",
    "relationbuilder": "node helpers/enricher/relation-builder.js",
    "upserter": "node helpers/enricher/upserter.js",
    "upserter:manager": "node helpers/enricher/upserter-manager.js",
    "expander": "node helpers/enricher/expander.js",

    "checker": "node helpers/tools/entryChecker.js",
    "compressor": "node helpers/tools/compressor.js"
  },
  "keywords": [
    "indonesian",
    "dictionary",
    "kamus",
    "kbbi",
    "slang",
    "lexicon",
    "sqlite"
  ],
  "author": "Kutomi",
  "license": "MIT",
  "files": [
    "src/"
  ],
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.2",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "uuid": "^14.0.1"
  }
}